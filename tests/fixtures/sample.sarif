{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "cargo-clippy",
          "version": "0.1.0",
          "rules": [
            {
              "id": "unsafe_code",
              "shortDescription": {
                "text": "Unsafe code usage detected"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "unsafe_code",
          "level": "warning",
          "message": {
            "text": "usage of an `unsafe` block"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/lib.rs"
                },
                "region": {
                  "startLine": 10,
                  "startColumn": 5
                }
              }
            }
          ]
        },
        {
          "ruleId": "unsafe_code",
          "level": "warning",
          "message": {
            "text": "declaration of an `unsafe` function"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/lib.rs"
                },
                "region": {
                  "startLine": 25,
                  "startColumn": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "unsafe_code",
          "level": "warning",
          "message": {
            "text": "unsafe pointer dereference"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/ffi.rs"
                },
                "region": {
                  "startLine": 42,
                  "startColumn": 13
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
